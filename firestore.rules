rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── TEMPORARY DEVELOPMENT RULES ────────────────────────────────────────
    // Access is restricted to authenticated Firebase users only.
    // DO NOT use: allow read, write: if true;
    //
    // These rules are intentionally temporary while Member 01 completes the
    // Firebase Authentication and role management system.
    //
    // TODO (post-auth integration): Replace these rules with role-based rules
    // that verify a Municipal Officer role, e.g. by checking a custom claim:
    //   request.auth.token.role == 'municipal_officer'
    // or a Firestore user profile document such as:
    //   get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'officer'
    // ─────────────────────────────────────────────────────────────────────────

    match /vehicles/{vehicleId} {
      allow create, read, update, delete: if request.auth != null;
    }

    match /drivers/{driverId} {
      allow create, read, update, delete: if request.auth != null;
    }

    match /staff/{staffId} {
      allow create, read, update, delete: if request.auth != null;
    }

    match /schedules/{scheduleId} {
      allow create, read, update, delete: if request.auth != null;
    }

  }
}
